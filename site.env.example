# Site settings for inference-router. Copy to site.env (git-ignored) and edit.
# env.sh sources site.env before anything else, so every script sees these.

# Project storage for the vLLM image, the model weights, the python env and the
# Rust toolchain. It can be the same directory llm-inference-bench uses, so
# nothing is pulled twice.
IR_DATA="/path/to/project/storage/inference-work"

# Environment modules. On clusters where the software tree sits behind a
# release meta-module, that module must load first, or loading Apptainer fails
# with a misleading "exist but cannot be loaded as requested". Leave it empty
# if your cluster has no such module.
IR_MOD_ENV=""
IR_MOD_APPTAINER="Apptainer"

# Optional: llm-inference-bench's lockfile, if that repo is not checked out next
# to this one.
# IR_LOCKFILE="/path/to/llm-inference-bench/provision.lock.json"
